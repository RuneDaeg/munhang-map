{
  "name": "munhang-map",
  "version": "0.7.4",
  "description": "모의고사 PDF 문항 분리·수식 복원·성취기준 분류 도구",
  "author": "문항맵",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "desktop:renderer": "vite build --config desktop/vite.renderer.config.ts",
    "desktop:dev": "vite build --config desktop/vite.renderer.config.ts && electron desktop/main.cjs",
    "desktop:dist": "vite build --config desktop/vite.renderer.config.ts && electron-builder --projectDir desktop --config electron-builder.yml --publish never",
    "desktop:mac": "vite build --config desktop/vite.renderer.config.ts && electron-builder --projectDir desktop --config electron-builder.yml --mac dmg --arm64 --publish never",
    "desktop:win": "vite build --config desktop/vite.renderer.config.ts && electron-builder --projectDir desktop --config electron-builder.yml --win nsis --x64 --publish never",
    "local": "vite build --config desktop/vite.renderer.config.ts && node local/server.cjs",
    "local:package": "vite build --config desktop/vite.renderer.config.ts && node local/scripts/package.cjs",
    "local:zip": "node local/scripts/zip.cjs",
    "local:release": "vite build --config desktop/vite.renderer.config.ts && node local/scripts/package.cjs && node local/scripts/zip.cjs",
    "test:providers": "node --test tests/provider-client.test.cjs",
    "test:pdf": "node --test tests/pdf-analysis.test.cjs tests/capture-editor.test.cjs",
    "test:glyphs": "node --test tests/pdf-text.test.cjs",
    "test:math": "node --test tests/math-normalization.test.cjs tests/question-view.test.cjs",
    "test:workflow": "node --test tests/analysis-workflow.test.cjs tests/question-bank.test.cjs tests/standard-export.test.cjs",
    "test:tables": "node --test tests/question-content.test.cjs tests/box-recovery.test.cjs tests/pdf-structures.test.cjs",
    "test:manual": "node --test tests/manual-issues.test.cjs",
    "test:formatting": "node --test tests/text-formatting.test.cjs",
    "test:choices": "node --test tests/choice-preservation.test.cjs",
    "test:local": "node --test tests/local-bank-http.test.cjs",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "katex": "^0.18.5",
    "lucide-react": "1.31.0",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
